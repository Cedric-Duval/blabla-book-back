{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": []
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"ignore": [
			"src/routers"
		]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noShadowRestrictedNames": "off",
				"noDuplicateParameters": "off",
				"noConsole": "off",
				"noDebugger": "error"
			},
			"correctness": {
				"noUnusedImports": "off",
				"noUnusedVariables": "off"
			}
		},
		"ignore": [
			"dist"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		{
			"include": [
				"./tsconfig.app.json",
				"./tsconfig.node.json"
			],
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		}
	]
}